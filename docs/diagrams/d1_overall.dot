digraph G {
  rankdir=TB; bgcolor="white";
  node [fontname="Noto Sans CJK KR", fontsize=11, shape=box, style="rounded,filled", penwidth=1.2];
  edge [fontname="Noto Sans CJK KR", fontsize=9, color="#5b6472"];
  graph [fontname="Noto Sans CJK KR", fontsize=13, labelloc=t, nodesep=0.35, ranksep=0.55];

  subgraph cluster_pres {
    label="Presentation Layer (Web / n8n 스타일)"; style="rounded,filled"; fillcolor="#eef2ff"; color="#c7d2fe"; fontcolor="#3730a3";
    ui [label="React + React Flow\n파이프라인 캔버스\n(드래그앤드롭 노드 에디터)", fillcolor="#c7d2fe", color="#818cf8"];
    mon [label="모니터링 대시보드\n실행 이력 / 로그 / 알림", fillcolor="#e0e7ff", color="#a5b4fc"];
  }

  subgraph cluster_api {
    label="API / BFF Layer (FastMCP)"; style="rounded,filled"; fillcolor="#ecfdf5"; color="#a7f3d0"; fontcolor="#065f46";
    gw [label="API Gateway / BFF\nREST + WebSocket + MCP", fillcolor="#a7f3d0", color="#34d399"];
    auth [label="인증·인가\nOAuth2 / RBAC / 시크릿", fillcolor="#d1fae5", color="#6ee7b7"];
  }

  subgraph cluster_core {
    label="Orchestration & Execution Layer"; style="rounded,filled"; fillcolor="#fff7ed"; color="#fed7aa"; fontcolor="#9a3412";
    orch [label="파이프라인 엔진\nDAG 오케스트레이터", fillcolor="#fed7aa", color="#fb923c"];
    sched [label="스케줄러\n(Cron / 트리거)", fillcolor="#ffedd5", color="#fdba74"];
    queue [label="Job Queue\n(Redis / Celery)", fillcolor="#ffedd5", color="#fdba74"];
    worker [label="Worker Pool\n(수집·변환·적재 실행)", fillcolor="#fed7aa", color="#fb923c"];
  }

  subgraph cluster_conn {
    label="Connector Layer"; style="rounded,filled"; fillcolor="#fdf2f8"; color="#fbcfe8"; fontcolor="#9d174b";
    dbc [label="DB 커넥터\nMySQL·MSSQL·PostgreSQL·MongoDB", fillcolor="#fbcfe8", color="#f472b6"];
    sapc [label="SAP 커넥터\n(RFC / BAPI)", fillcolor="#fce7f3", color="#f9a8d4"];
    cdc [label="CDC 커넥터\n(Debezium)", fillcolor="#fce7f3", color="#f9a8d4"];
  }

  subgraph cluster_store {
    label="Source / Target Storage"; style="rounded,filled"; fillcolor="#f1f5f9"; color="#cbd5e1"; fontcolor="#334155";
    src [label="Source\nRDB / NoSQL / SAP", fillcolor="#e2e8f0", color="#94a3b8"];
    tgt [label="Target\nDB / Amazon S3", fillcolor="#e2e8f0", color="#94a3b8"];
  }

  meta [label="Metadata Store\n(파이프라인·스키마·실행이력·오프셋)\nPostgreSQL", shape=cylinder, fillcolor="#fef9c3", color="#fde047", fontcolor="#713f12"];

  ui -> gw; mon -> gw;
  gw -> auth [style=dashed, arrowhead=none];
  gw -> orch; gw -> sched;
  sched -> orch -> queue -> worker;
  worker -> dbc; worker -> sapc; worker -> cdc;
  dbc -> src [dir=both]; sapc -> src [dir=both]; cdc -> src;
  worker -> tgt;
  orch -> meta [style=dashed, arrowhead=none, label="상태/이력"];
  worker -> meta [style=dashed, arrowhead=none];
}
