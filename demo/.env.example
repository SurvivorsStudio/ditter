# demo/.env 로 복사해서 쓴다. compose 가 이 디렉터리의 .env 를 자동으로 읽는다.
#
# 여기 값은 **로컬 시연용 가상 DB 전용**이다. `down -v` 하면 사라진다.
# 포트는 compose 가 127.0.0.1 에만 여므로 이 컴퓨터 밖에서는 붙지 못한다 — 그 바인딩을
# 0.0.0.0 으로 되돌리면 아래 비밀번호가 저장소에 공개돼 있으므로 같은 망의 누구나 붙는다.
# 그래도 실제 자격증명은 절대 넣지 말 것 — **이 파일(.env.example)은 저장소에 그대로
# 커밋된다.** .gitignore 되는 것은 여기서 복사해 쓰는 demo/.env 쪽이다.

# 계정 비밀번호 (SQL Server 복잡도 요건: 대·소문자 + 숫자/특수문자 포함 8자 이상)
DEMO_MYSQL_ROOT_PASSWORD=DitterDemo!2026
DEMO_MSSQL_SA_PASSWORD=DitterDemo!2026
DEMO_PG_PASSWORD=DitterDemo!2026
DEMO_APP_PASSWORD=DitterDemo!2026        # eai_ro / eai_rw / eai_ddl 공통
DEMO_DEBEZIUM_PASSWORD=DitterDemo!2026   # CDC 복제 계정
DEMO_SYM_PASSWORD=DitterDemo!2026        # SymmetricDS 노드 계정

# 호스트 포트 (본체 스택과 겹치지 않게 비켜 두었다. 127.0.0.1 로만 공개된다)
DEMO_MYSQL_PORT=3307
DEMO_MSSQL_PORT=1433
DEMO_PG_PORT=5433

# small | standard | large
DEMO_SCALE=standard
