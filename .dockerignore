# 빌드 컨텍스트에서 뺄 것들.
#
# 이게 없으면 docker 가 매 빌드마다 저장소 전체(.venv 수백 MB, node_modules, .git)를
# 데몬으로 전송한다. COPY 하지 않는 파일이어도 전송은 일어나므로, 한 줄 고치고 빌드해도
# 컨텍스트 전송에서 시간이 다 간다.

# 가상환경·의존성 — 이미지 안에서 새로 설치한다
**/.venv
**/venv
**/node_modules

# 파이썬 캐시
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# 프론트 빌드 산출물 (web 이미지는 자체 컨텍스트에서 새로 빌드한다)
**/dist
**/.vite

# 버전 관리·에디터
.git
.gitignore
.claude
**/.DS_Store

# 문서·목업 — 이미지에 들어갈 일이 없다
docs

# 시크릿이 들어갈 수 있는 것 — 이미지에 굽지 않는다
.env
.env.*
!.env.example
