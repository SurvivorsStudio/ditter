# 노드 B — 타깃 (PostgreSQL). 기획안 §5-2.
#
# 이 파일을 `eai-target.properties` 로 복사해 값을 채운다.
# engine.name 은 API 설정 EAI_SYMMETRIC_TARGET_ENGINE 과 같아야 한다.

engine.name=eai-target
group.id=target
external.id=002

# SYM_* 를 전용 스키마(sync)에 만든다 — 업무 테이블이 있는 public 이 더러워지지 않게.
# PostgreSQL 은 한 커넥션에서 다른 **데이터베이스**를 볼 수 없어 MSSQL 처럼 DB 를 뺄 수 없다.
# search_path 에 public 을 남겨 두는 것이 중요하다 — 적재 대상 테이블이 거기 있다.
db.driver=org.postgresql.Driver
db.url=jdbc:postgresql://PG_HOST:5432/wmsdb?currentSchema=sync,public
db.user=sym_user
db.password=CHANGE_ME

sync.url=http://symmetricds:31415/sync/eai-target
# 타깃은 소스에 자기를 등록한다. 이 주소가 틀리면 노드가 영영 등록되지 않고,
# 모니터의 지표에 "타깃 노드 등록 대기"로 남는다 — 데이터는 한 건도 가지 않는다.
registration.url=http://symmetricds:31415/sync/eai-source

sync.table.prefix=SYM
