digraph G {
  rankdir=LR; bgcolor="white";
  node [fontname="Noto Sans CJK KR", fontsize=10, shape=box, style="rounded,filled"];
  edge [fontname="Noto Sans CJK KR", fontsize=9, color="#5b6472"];
  graph [fontname="Noto Sans CJK KR", fontsize=12, nodesep=0.4, ranksep=0.6];

  trigger [label="트리거\nCron / 수동 / 이벤트", fillcolor="#ffedd5", color="#fdba74"];
  main [label="Main (Orchestrator)\n· DAG 파싱\n· 실행 인스턴스 생성\n· Job enqueue", fillcolor="#fed7aa", color="#fb923c"];
  redis [label="Redis Queue\n(대기 실행 큐)", shape=cylinder, fillcolor="#fee2e2", color="#fca5a5"];

  subgraph cluster_w {
    label="Worker Pool (수평 확장)"; style="rounded,filled"; fillcolor="#eef2ff"; color="#c7d2fe"; fontcolor="#3730a3"; fontname="Noto Sans CJK KR";
    w1 [label="Worker 1\nExtract→Transform→Load", fillcolor="#c7d2fe", color="#818cf8"];
    w2 [label="Worker 2", fillcolor="#c7d2fe", color="#818cf8"];
    w3 [label="Worker N", fillcolor="#c7d2fe", color="#818cf8"];
  }

  meta [label="Metadata DB\n실행상태·로그·체크포인트", shape=cylinder, fillcolor="#fef9c3", color="#fde047"];
  ws [label="WebSocket\n실시간 진행상황 push", fillcolor="#d1fae5", color="#6ee7b7"];

  trigger -> main -> redis;
  redis -> w1; redis -> w2; redis -> w3;
  w1 -> meta [style=dashed]; w2 -> meta [style=dashed]; w3 -> meta [style=dashed];
  main -> meta [style=dashed];
  meta -> ws -> main [style=dotted, constraint=false, label="UI 반영"];
}
