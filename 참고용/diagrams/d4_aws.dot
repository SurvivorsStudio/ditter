digraph G {
  rankdir=TB; bgcolor="white";
  node [fontname="Noto Sans CJK KR", fontsize=10, shape=box, style="rounded,filled"];
  edge [fontname="Noto Sans CJK KR", fontsize=9, color="#5b6472"];
  graph [fontname="Noto Sans CJK KR", fontsize=12, nodesep=0.35, ranksep=0.5, compound=true];

  user [label="사용자 (브라우저)", shape=ellipse, fillcolor="#e0e7ff", color="#a5b4fc"];

  subgraph cluster_vpc {
    label="AWS VPC"; style="rounded,filled"; fillcolor="#f8fafc"; color="#cbd5e1"; fontcolor="#334155"; fontname="Noto Sans CJK KR";

    alb [label="ALB (HTTPS)\nACM 인증서", fillcolor="#fde68a", color="#fbbf24"];

    subgraph cluster_pub {
      label="Public Subnet"; style="rounded,filled"; fillcolor="#eff6ff"; color="#bfdbfe"; fontname="Noto Sans CJK KR";

      subgraph cluster_ec2 {
        label="EC2 (Docker Compose / ECS on EC2)"; style="rounded,filled"; fillcolor="#eef2ff"; color="#c7d2fe"; fontcolor="#3730a3"; fontname="Noto Sans CJK KR";
        c_fe [label="frontend\n(Nginx+React)", fillcolor="#c7d2fe"];
        c_api [label="fastmcp-api", fillcolor="#c7d2fe"];
        c_orch [label="orchestrator", fillcolor="#fed7aa", color="#fb923c"];
        c_wk [label="worker ×N", fillcolor="#fed7aa", color="#fb923c"];
        c_dbz [label="debezium\n(Kafka Connect)", fillcolor="#bfdbfe", color="#93c5fd"];
        c_redis [label="redis", shape=cylinder, fillcolor="#fee2e2", color="#fca5a5"];
        c_kafka [label="kafka", shape=cylinder, fillcolor="#fee2e2", color="#fca5a5"];
      }
    }

    subgraph cluster_priv {
      label="Private Subnet"; style="rounded,filled"; fillcolor="#f0fdf4"; color="#bbf7d0"; fontname="Noto Sans CJK KR";
      rds [label="RDS (PostgreSQL)\n메타데이터 스토어", shape=cylinder, fillcolor="#bbf7d0", color="#4ade80"];
    }
  }

  s3 [label="Amazon S3\n(적재 타깃 / 로그·아티팩트)", shape=cylinder, fillcolor="#fef9c3", color="#fde047"];
   src [label="소스 시스템\n온프레미스 DB / SAP\n(VPN·Direct Connect)", fillcolor="#e2e8f0", color="#94a3b8"];
  ecr [label="Amazon ECR\n(컨테이너 이미지)", fillcolor="#f1f5f9", color="#cbd5e1"];
  cw [label="CloudWatch\n로그·메트릭·알람", fillcolor="#f1f5f9", color="#cbd5e1"];

  user -> alb -> c_fe; alb -> c_api;
  c_api -> c_orch -> c_redis; c_orch -> c_wk; c_redis -> c_wk;
  c_dbz -> c_kafka -> c_wk;
  c_api -> rds [ltail=cluster_ec2]; c_orch -> rds; c_wk -> rds;
  c_wk -> s3; c_wk -> src [dir=both]; c_dbz -> src;
  ecr -> c_api [style=dashed, arrowhead=none, label="deploy"];
  c_wk -> cw [style=dotted];
}
