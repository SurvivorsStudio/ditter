# 이 파일을 `.env` 로 복사해서 쓴다. `.env` 는 커밋하지 않는다.
# docs/policy/credential-management.md — 실제 자격증명은 저장소에 들어가지 않는다.

# 백엔드
# 기본은 내 컴퓨터에서만 접속을 받는다. 같은 네트워크의 다른 기기에서 붙어야 할 때만
# 0.0.0.0 으로 바꾼다 — 인증은 STEP 8 에서야 생긴다.
HOST=127.0.0.1
PORT=4000

# 프런트 개발 서버도 같은 규칙이다. 여기를 열면 dev 서버의 /api 프록시를 타고 위 백엔드의
# 루프백 바인딩까지 함께 우회된다. 컨테이너는 docker-compose.yml 이 0.0.0.0 으로 덮는다.
VITE_DEV_HOST=127.0.0.1

# 로컬 개발용 PostgreSQL (docker compose 의 db 서비스와 값이 같아야 한다)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ditter_dev
POSTGRES_USER=ditter
POSTGRES_PASSWORD=ditter_local_dev_only
