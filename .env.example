# 이 파일을 `.env` 로 복사해서 쓴다. `.env` 는 커밋하지 않는다(.gitignore).
#
#   cp .env.example .env
#
# 이 파일을 읽는 것은 **docker compose** 다 — docker-compose.yml 의 ${VAR} 치환에 쓰인다.
# 그래서 여기에 없는 이름을 적어도 컨테이너에 전달되지 않는다(compose 가 넘기는 것만 간다).
#
# 호스트에서 직접 돌릴 때(README 「로컬 개발」)는 이야기가 다르다. 백엔드 설정은
# pydantic-settings 가 **프로세스의 현재 디렉터리** 기준으로 `.env` 를 찾으므로,
# `cd apps/api && uvicorn ...` 은 이 루트 파일을 읽지 않는다. 그때는 셸에 export 하거나
# 필요한 값만 `apps/api/.env` 에 따로 둔다.
#
# ─────────────────────────────────────────────────────────────────────────────
# 반드시 채워야 하는 것 — 이 둘이 비면 `docker compose up` 이 아예 뜨지 않는다
# ─────────────────────────────────────────────────────────────────────────────
# docker-compose.yml 이 `${VAR:?...}` 로 선언해 값이 없으면 즉시 실패한다. 나머지 항목은
# 전부 기본값이 있어 이 둘만 채우면 바로 기동한다.

# 연결 설정의 비밀값(DB 비밀번호 등)을 암호화하는 Fernet 키.
# 메타DB 에는 암호문만 남는다 — 이 키를 잃으면 저장된 연결의 비밀값을 복호화할 수 없다.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EAI_LOCAL_SECRET_KEY=

# 로그인 토큰(JWT) 서명 키. **32바이트 미만이면 기동을 거부한다**(RFC 7518 §3.2 —
# HS256 서명 위조를 막기 위한 최소 길이). 아래 명령이 64자 hex 를 만든다.
#   openssl rand -hex 32
EAI_JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 자주 건드리는 것
# ─────────────────────────────────────────────────────────────────────────────

# 인증. 로컬에서 로그인 없이 쓰려면 false. 이 값은 프런트 빌드에도 함께 들어간다
# (compose 가 web 의 VITE_AUTH_ENABLED 로 넘긴다) — 한쪽만 끄면 화면과 서버가 어긋난다.
# false 로 두면 위 EAI_JWT_SECRET 이 비어 있어도 API 는 뜬다.
EAI_AUTH_ENABLED=true

# 호스트에 노출할 포트. 이미 쓰는 것과 겹칠 때만 바꾼다.
# WEB_PORT 를 바꾸면 API 의 CORS 허용 출처(기본 5173·4173)에서 벗어나 브라우저가 막는다 —
# 그때는 EAI_CORS_ORIGINS 도 함께 넘기도록 docker-compose.yml 을 수정해야 한다.
WEB_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# 프런트가 호출할 API 주소. **브라우저에서 보이는 주소**라 컨테이너 이름이 아니라
# 호스트 주소다. 빌드 시점에 굽히므로 바꾸면 web 을 다시 빌드해야 한다.
VITE_API_BASE=http://localhost:8000

# 메타데이터 DB (컨테이너로 뜨는 PostgreSQL). 로컬 전용 값이라 그대로 둬도 된다.
# 외부에 노출된 호스트에서 돌린다면 반드시 바꾼다.
POSTGRES_USER=eai
POSTGRES_PASSWORD=eai
POSTGRES_DB=eai

# 워커 프로세스 수. 파이프라인을 동시에 여러 개 돌릴 때 늘린다.
WORKER_REPLICAS=1

# ─────────────────────────────────────────────────────────────────────────────
# 필요할 때만
# ─────────────────────────────────────────────────────────────────────────────

# 비밀값 저장 방식. local = 위 Fernet 키로 암호화. aws_kms 로 바꾸려면 EAI_KMS_KEY_ID 를
# 컨테이너에 넘기도록 docker-compose.yml 도 함께 고쳐야 한다(지금은 넘기지 않는다).
EAI_SECRET_BACKEND=local

# S3 타깃을 쓸 때만. 비워 두면 boto3 의 기본 자격증명 탐색(~/.aws, IAM 역할)을 따른다.
# AWS_ENDPOINT_URL 은 MinIO 같은 S3 호환 저장소를 쓸 때 지정한다.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# 로컬 파일 타깃의 격리 루트. 모든 산출물은 이 아래에만 만들어진다.
# 기본은 exportsdata 볼륨이라 api·worker 가 공유한다. 호스트에서 결과 파일을 직접 보려면
# docker-compose.yml 의 해당 볼륨을 bind mount 로 바꾼다.
EAI_LOCAL_FILE_ROOT=/data/exports

# 연합 조회(DuckDB)는 api 프로세스 안에서 돈다 — 조인이 커지면 그 메모리를 api 가 그대로
# 쓰므로 상한을 둔다. 넘으면 디스크로 흘리거나 실패할 뿐 프로세스가 죽지는 않는다.
EAI_DUCKDB_MEMORY_LIMIT=1GB

# ── SAP RFC 사이드카 ─────────────────────────────────────────────────────────
# 기본은 목(mock) 백엔드로 뜬다 — NW RFC SDK 없이 개발·검증할 수 있다.
# 실제 SAP 에 붙이려면 apps/sap-connector/vendor/nwrfcsdk/ 를 채우고
# SAP_WITH_NWRFC=1 로 빌드한 뒤 EAI_SAP_BACKEND=nwrfc 로 바꾼다.
EAI_SAP_BACKEND=mock
SAP_WITH_NWRFC=0
SAP_PORT=8100
# 사이드카를 보호하는 토큰. 비우면 검사하지 않는다.
EAI_SAP_API_TOKEN=
# 사이드카 기본 주소. SAP 연결이 sidecar_url 을 비워두면 이 값을 쓴다.
EAI_SAP_DEFAULT_SIDECAR_URL=http://sap-connector:8100
# 아래 접속 정보는 **보통 비워 둔다.** SAP 접속 정보는 연결 설정(UI)에 암호화 저장되어
# 요청 body 로 사이드카에 전달된다. 이 값들은 요청에 접속 정보가 전혀 없을 때의 폴백이다.
EAI_SAP_ASHOST=
EAI_SAP_CLIENT=
EAI_SAP_USER=
EAI_SAP_PASSWD=

# ── 실시간 DB 동기화 (SymmetricDS) — `docker compose --profile sync up -d` ──
# 엔진 이름은 sync/symmetricds/engines/*.properties 의 engine.name 과 **반드시 같아야 한다.**
# 어긋나면 설정은 들어가는데 반영만 조용히 늦어져 원인을 찾기 어렵다.
SYMMETRIC_VERSION=3.15
SYMMETRIC_PORT=31415
EAI_SYMMETRIC_URL=http://symmetricds:31415
EAI_SYMMETRIC_SOURCE_ENGINE=eai-source
EAI_SYMMETRIC_TARGET_ENGINE=eai-target
EAI_SYMMETRIC_TABLE_PREFIX=SYM

# ── 로컬 오픈웨이트 AI — `docker compose --profile ai up -d` ────────────────
# 상용 API 없이 AI 어시스턴트를 돌리는 경로. 모델은 이미지에 없으므로 한 번 받아야 한다:
#   docker compose --profile ai exec ollama ollama pull qwen3:8b
# 127.0.0.1 에만 열린다 — Ollama HTTP API 에는 인증이 없다.
# 맥은 컨테이너에서 GPU 를 못 쓰므로, 호스트에 ollama 를 설치하고 연결 엔드포인트를
# http://host.docker.internal:11434 로 두는 편이 훨씬 빠르다.
OLLAMA_PORT=11434
