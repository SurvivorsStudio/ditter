# 의존성
node_modules/

# 빌드 산출물
dist/
build/
.vite/
*.tsbuildinfo

# 환경 변수 (DB 접속 정보 등 비밀값 — docs/policy/credential-management.md)
.env
.env.*
!.env.example

# 로컬 SQLite (접속 설정·감사 로그 등 런타임 데이터 — 커밋 대상 아님)
# WAL 모드를 켜므로 `-wal`·`-shm` 곁파일이 함께 생긴다. 접미사가 붙어 `*.sqlite` 에 걸리지
# 않으므로 따로 적는다 (backend/src/db/sqlite.ts).
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.db
/data/
/backend/data/

# 로그
*.log
npm-debug.log*

# 테스트 커버리지
coverage/

# 세션 작업 기록 (로컬 전용 — .claude/commands/done.md 참고)
.done/

# 로컬 요구사항·기획 메모 (하위 디렉토리 포함, 커밋 대상 아님)
.requirements/

# Claude Code 개인별 로컬 설정 (팀 공유 설정은 .claude/settings.json)
.claude/settings.local.json

# /review 세션 상태 (어느 HEAD 를 몇 번 리뷰했는지 — .claude/commands/review.md 참고)
.claude/.review-state.json

# Docker 로컬 오버라이드
docker-compose.override.yml

# 컨테이너가 죽으면서 bind mount 된 소스 디렉토리에 떨군 코어 덤프 (수백 MB 짜리가 나온다).
# 슬래시 없는 `core` 패턴은 모든 깊이에 매칭돼 `backend/src/core/` 같은 소스 디렉토리까지
# 통째로 무시해 버리므로, 덤프가 실제로 떨어지는 위치만 정확히 짚는다.
/backend/core
/backend/core.*
/frontend/core
/frontend/core.*
/packages/*/core
/packages/*/core.*

# 에디터/IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
